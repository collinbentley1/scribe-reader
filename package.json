{
  "name": "scribe-reader",
  "version": "0.1.0",
  "description": "A local reader for Kindle Scribe cloud notebooks",
  "license": "MIT",
  "private": true,
  "main": "dist/main.cjs",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun build src/main.ts --target=node --format=cjs --external=electron --external=pngjs --outfile=dist/main.cjs",
    "start": "electron .",
    "check": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write src test README.md package.json tsconfig.json"
  },
  "dependencies": {
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "typescript": "7.0.2",
    "@types/node": "22.20.2",
    "@types/pngjs": "6.0.5",
    "prettier": "3.9.6"
  }
}
